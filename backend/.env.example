# Copy to .env and adjust. docker-compose provides the Postgres defaults below.
# For quick local dev without Postgres, use SQLite instead:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
#   AUTO_CREATE_TABLES=true
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobscraper
CORS_ORIGINS=http://localhost:3000

# development enables create_all on startup; production relies on Alembic.
ENVIRONMENT=development
AUTO_CREATE_TABLES=true

# Guards POST /crawl and POST /companies via the X-API-Key header.
# Empty = open (local dev). Always set a value in production.
ADMIN_API_KEY=

# How long a freshly discovered job stays flagged is_new.
NEW_JOB_WINDOW_HOURS=48

# Per-domain politeness / HTTP client.
REQUEST_MIN_INTERVAL_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3

# Source volume caps (bound against the free Postgres size limit).
WORKDAY_MAX_JOBS=200
THEMUSE_MAX_PAGES=99
REMOTIVE_MAX_JOBS=600
JOBICY_MAX_JOBS=300
ADZUNA_MAX_JOBS=1000

# Adzuna broad-US aggregator — free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Planned (not yet wired; see CODEX_HANDOFF.md §8) --------------------------
# Google Programmable Search (ATS token harvesting) — free 100 queries/day.
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
