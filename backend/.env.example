# Copy to .env and adjust. docker-compose provides these defaults.
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobscraper
CORS_ORIGINS=http://localhost:3000
# Guards /crawl and POST /companies. Empty = open (local dev). Set in production.
ADMIN_API_KEY=
NEW_JOB_WINDOW_HOURS=48
REQUEST_MIN_INTERVAL_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3
